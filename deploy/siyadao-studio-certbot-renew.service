[Unit]
Description=Renew Siyadao Studio HTTPS certificate without stopping Nginx
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
UMask=0077
# 独立配置目录避开旧站点的全局 stop/start 钩子；续期成功后才平滑重载。
ExecStart=/usr/bin/certbot renew --quiet --config-dir /etc/letsencrypt-studio --work-dir /var/lib/letsencrypt-studio --logs-dir /var/log/letsencrypt-studio --cert-name studio.siyadao.cn --deploy-hook "/usr/sbin/nginx -t && /bin/systemctl reload nginx.service"
